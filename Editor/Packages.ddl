// Packages this project uses.
//
// Part of the project rather than of user settings: a clone of this repository gets the
// list, and the editor offers to install anything missing. For a package that is not on a
// public registry, this is the only record that the project needs it.
//
// Version is what the project was last built against. Removing it means "whatever is
// installed".

Package
{
	string %Id{"plasma.visualscript"}
	string %Version{"1.3.1"}
}
Package
{
	string %Id{"plasma.gameui"}
	string %Version{"1.4.0"}
}
Package
{
	string %Id{"plasma.particles"}
	string %Version{"1.8.1"}
}
